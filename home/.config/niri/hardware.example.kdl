    // transform "normal"
}

/-output "HDMI-A-1" {
    // mode: not set
    // scale: not set
    // position: not set
    // transform "270"
}

/-output "eDP-1" {
    // mode: not set
    // scale 0.9
    // position: not set
    // transform: not set
}
