# Main background, accents and key color
theme[main_bg]="#0e1415"
theme[main_fg]="#dde4e4"
theme[title]="#dde4e4"
theme[hi_fg]="#80d4d9"
theme[selected_bg]="#303636"
theme[selected_fg]="#80d4d9"
theme[inactive_fg]="#899393"
theme[graph_text]="#bec8c9"

# Text color for box borders
theme[proc_box]="#80d4d9"
theme[cpu_box]="#b1cccd"
theme[mem_box]="#b6c7e9"
theme[net_box]="#80d4d9"

# Outline color of boxes
theme[proc_border]="#899393"
theme[cpu_border]="#899393"
theme[mem_border]="#899393"
theme[net_border]="#899393"

# CPU graph colors
theme[cpu_start]="#80d4d9"
theme[cpu_mid]="#b1cccd"
theme[cpu_end]="#b6c7e9"

# Mem box outline color
theme[free]="#80d4d9"
theme[cached]="#b1cccd"
theme[available]="#b6c7e9"
theme[used]="#ffb4ab"

# Download/Upload graph colors
theme[download_start]="#80d4d9"
theme[download_mid]="#b1cccd"
theme[download_end]="#b6c7e9"
theme[upload_start]="#b6c7e9"
theme[upload_mid]="#b1cccd"
theme[upload_end]="#80d4d9"
